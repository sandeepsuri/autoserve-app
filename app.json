{
  "expo": {
    "name": "AutoServe",
    "slug": "autoserve-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/book-and-go-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "autoserve",
    "splash": {
      "image": "./assets/brand/book-and-go-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vibez.autoserve",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AutoServe uses your location to show nearby automotive service providers and route mobile service bookings.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vibez.autoserve",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/book-and-go-adaptive.png",
        "backgroundColor": "#0B1220"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/brand/book-and-go-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.vibez.autoserve",
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a0bb91f4-a7a8-47b6-8540-d07e96bf9a86"
      }
    }
  }
}
