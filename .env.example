# Supabase project credentials (required)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API base URL for vehicle catalog lookups.
# For local dev this can be left as http://localhost:3000.
# For EAS preview/production builds, configure this in the EAS dashboard
# under Environment Variables for each profile — .env is NOT bundled into
# cloud builds.
EXPO_PUBLIC_API_BASE_URL=https://your-api.example.com

# Demo data flag (optional)
EXPO_PUBLIC_ENABLE_DEMO_DATA=

# Google Maps API key for Android (required for the map on Android).
# Create in Google Cloud Console with "Maps SDK for Android" enabled and
# restrict it to package com.vibez.autoserve + your keystore SHA-1.
# Consumed at prebuild time via app.config.ts — also set this in the EAS
# dashboard (preview and production environments) for cloud builds.
GOOGLE_MAPS_ANDROID_API_KEY=

# Supabase Edge Function secrets (set with `supabase secrets set`, never expose
# these as EXPO_PUBLIC values). Guest bookings remain valid and queued if email
# delivery is temporarily unavailable.
RESEND_API_KEY=re_your_restricted_key
GUEST_BOOKING_FROM_EMAIL=AutoServe <bookings@your-domain.example>
GUEST_EMAIL_RETRY_SECRET=replace-with-a-long-random-secret
